# The same rule for the one fetched file of 00_raw/05_forest_reference/ (decided 7 Oct 2026): the Global Forest Watch
# workbook is a download with its URL, size and sha256 in data_manifest.csv, carries no stated licence, and
# collect_data.py fetches it (kind http). The two ISFR text files beside it STAY tracked: they are page extracts made
# here, a few KB each, and cannot be fetched as files.
00_raw/05_forest_reference/gfw_IND.xlsx

# session scratch: test outputs, logs, the replication's cache (several GB)
.session_scratch_*/

# the demo layer is a stage output like the others (the library it embeds is tracked under scripts/vendor/)
60_layer/

# logs of the unattended NIRv chain (scripts/run_nirv_chain.py)
logs/

# the Gazette PDFs of 00_raw/06_scheme/ (added 8 Oct 2026): fetched files, each with its URL, bytes and sha256 in the manifest.
# The table and the transcription made from them here stay tracked, with the script that checks them.
00_raw/06_scheme/*.pdf
00_raw/06_scheme/*.html

